<?xml version="1.0" encoding="UTF-8"?>
<!-- mybatis mapper 설정 파일임을 선언한다. -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.oraclejava.mini.todos.mapper.TodoMapper">
    <!-- 필요한 쿼리문과 매핑 구문들을 작성한다. -->
    <!--
    resultMap은 DB 조회 결과와 자바 객체를 명시적으로 매핑할 때 사용한다.
    -->
    <resultMap id="todoResultMap" type="Todo">
        <!-- 조회 결과의 기본 키(PK) 컬럼을 매핑한다. -->
        <!-- property: 자바 객체의 필드 이름, column: 조회 결과의 열 이름 -->
        <id property="id" column="id"/>
        <!-- 조회 결과의 일반 컬럼을 매핑한다. -->
        <result property="title" column="title"/>
        <result property="importance" column="importance"/>
        <result property="urgency" column="urgency"/>
        <result property="deadline" column="deadline"/>
        <result property="done" column="done"/>
    </resultMap>

    <select id="selectAll" resultMap="todoResultMap">
        SELECT id,
               title,
               importance,
               urgency,
               deadline,
               done
        FROM todo
        # ORDER BY deadline ASC
    </select>

    <insert id="insertTodo" parameterType="Todo">
        INSERT INTO todo (
            title,
            importance,
            urgency,
            deadline
        ) values (
             #{title},
             #{importance},
             #{urgency},
             #{deadline}
         )
    </insert>

    <delete id="deleteTodo" parameterType="_int">
        DELETE
        FROM todo
        WHERE id = #{id}
    </delete>
</mapper>